{
  "name": "@webship.co/workspace-godaddy",
  "version": "1.0.12",
  "description": "GoDaddy for Webship Workspace: the GODADDY menu on every site row, the domain and its DNS from the GoDaddy API, the hosting account over SSH (get database and files, deploy with rsync, the error log), the GoDaddy console. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A provider of @webship.co/workspace-hosting.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-godaddy.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "godaddy",
    "label": "GoDaddy",
    "needs": {
      "plugins": [
        [
          "dev",
          "test",
          "demos",
          "sandboxes",
          "projects"
        ],
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        "curl",
        "python3"
      ]
    },
    "suggests": {
      "commands": [
        "ssh",
        "rsync"
      ]
    },
    "settingsFile": "plugin.godaddy.settings.yml",
    "settingsTemplate": "config/plugin.godaddy.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "godaddy",
    "typeActions": {
      "godaddy": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-godaddy.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-godaddy.sh",
        "scripts/functions/fun-godaddy-tool.sh"
      ],
      "args": [
        "scripts/args/arg-godaddy.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/godaddy-deployer.md"
      ],
      "skills": [
        "ai/skills/godaddy-hosting"
      ],
      "commands": [
        "ai/commands/godaddy-status.md"
      ],
      "prompts": [
        "ai/prompts/godaddy-test-then-deploy.md"
      ]
    },
    "features": [
      "features/godaddy.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-hosting": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
